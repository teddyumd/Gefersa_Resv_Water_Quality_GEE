// =============================================
// STEP 3: WATER MASKING AND QUALITY PARAMETERS
// =============================================

function createReservoirWaterMask(image) {
  var mndwi = image.normalizedDifference(['B3', 'B11']).rename('MNDWI');
  var aweish = image.select('B2').multiply(2.5)
    .subtract(image.select('B3').multiply(1.5))
    .subtract(image.select('B8').multiply(0.25))
    .subtract(image.select('B11').multiply(0.75))
    .add(0.5);
  var waterMask = mndwi.gt(0.0).and(aweish.gt(0));
  return waterMask.selfMask();
}

var waterMask = createReservoirWaterMask(composite);
var waterComposite = composite.updateMask(waterMask);

// Calculate water quality parameters
function calculateTSS(image) {
  var red = image.select('B4');
  var green = image.select('B3');
  var nir = image.select('B8');
  var tss1 = red.divide(green).multiply(3.0);
  var tss2 = nir.divide(red).multiply(2.0);
  var tss = tss1.multiply(0.6).add(tss2.multiply(0.4)).subtract(0.8).rename('TSS');
  return tss.unitScale(0, 8);
}

function calculateTurbidity(image) {
  var blue = image.select('B2');
  var green = image.select('B3');
  var red = image.select('B4');
  var turb1 = blue.add(green).multiply(0.00015);
  var turb2 = red.divide(green).multiply(2.0);
  var turbidity = turb1.add(turb2).rename('Turbidity');
  return turbidity.unitScale(0, 12);
}

function calculateDOProxy(image) {
  var ndci = image.normalizedDifference(['B5', 'B4']).rename('NDCI');
  var doProxy = ndci.multiply(-2.5).add(3.0).rename('DO_Proxy');
  return doProxy.unitScale(0, 12);
}

function calculateChlorophyll(image) {
  var blue = image.select('B2');
  var green = image.select('B3');
  var redEdge1 = image.select('B5');
  var red = image.select('B4');
  var chl1 = blue.divide(green).multiply(120);
  var chl2 = redEdge1.divide(red).multiply(80);
  var chlorophyll = chl1.add(chl2).divide(2).rename('Chlorophyll');
  return chlorophyll.unitScale(0, 60);
}

var tss = calculateTSS(waterComposite);
var turbidity = calculateTurbidity(waterComposite);
var doProxy = calculateDOProxy(waterComposite);
var chlorophyll = calculateChlorophyll(waterComposite);

function calculateReservoirWQI(tss, turbidity, doProxy, chlorophyll) {
  var wqi = tss.multiply(0.25)
              .add(turbidity.multiply(0.30))
              .add(doProxy.multiply(0.25))
              .add(chlorophyll.multiply(0.20))
              .rename('WQI');
  return wqi;
}

var waterQualityIndex = calculateReservoirWQI(tss, turbidity, doProxy, chlorophyll);

var wqiClasses = waterQualityIndex
  .where(waterQualityIndex.lt(0.2), 1)
  .where(waterQualityIndex.gte(0.2).and(waterQualityIndex.lt(0.4)), 2)
  .where(waterQualityIndex.gte(0.4).and(waterQualityIndex.lt(0.6)), 3)
  .where(waterQualityIndex.gte(0.6).and(waterQualityIndex.lt(0.8)), 4)
  .where(waterQualityIndex.gte(0.8), 5)
  .rename('WQI_Class');

