// -------------- DATA / HELPERS --------------
function maskS2sr(img){
  var qa = img.select('QA60');
  var cloud = 1 << 10, cirrus = 1 << 11;
  var qaMask = qa.bitwiseAnd(cloud).eq(0).and(qa.bitwiseAnd(cirrus).eq(0));
  var scl = img.select('SCL');
  var sclMask = scl.neq(3).and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10)).and(scl.neq(11));
  return img.updateMask(qaMask).updateMask(sclMask).copyProperties(img, img.propertyNames());
}

function loadS2(start, end){
  return ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterBounds(gefersaReservoir)
    .filterDate(start, end)
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 40))
    .map(maskS2sr)
    .select(['B2','B3','B4','B5','B6','B7','B8','B8A','B11','B12','SCL']);
}

function createWaterMask(image){
  var mndwi = image.normalizedDifference(['B3','B11']);
  var aweish = image.select('B2').multiply(2.5)
    .subtract(image.select('B3').multiply(1.5))
    .subtract(image.select('B8').multiply(0.25))
    .subtract(image.select('B11').multiply(0.75))
    .add(0.5);
  return mndwi.gt(0.0).and(aweish.gt(0)).selfMask();
}

function calcTSS(img){
  var red = img.select('B4'), green = img.select('B3'), nir = img.select('B8');
  var tss = red.divide(green).multiply(3.0).multiply(0.6)
    .add(nir.divide(red).multiply(2.0).multiply(0.4))
    .subtract(0.8);
  return tss.unitScale(0,8).rename('TSS');
}
function calcTurbidity(img){
  var blue = img.select('B2'), green = img.select('B3'), red = img.select('B4');
  var turb = blue.add(green).multiply(0.00015).add(red.divide(green).multiply(2.0));
  return turb.unitScale(0,12).rename('Turbidity');
}
function calcDOProxy(img){
  var ndci = img.normalizedDifference(['B5','B4']);
  var dop = ndci.multiply(-2.5).add(3.0);
  return dop.unitScale(0,12).rename('DO_Proxy');
}
function calcChl(img){
  var blue = img.select('B2'), green = img.select('B3'), re1 = img.select('B5'), red = img.select('B4');
  var chl = blue.divide(green).multiply(120).add(re1.divide(red).multiply(80)).divide(2);
  return chl.unitScale(0,60).rename('Chlorophyll');
}
function calcWQI(tss, turb, dop, chl){
  return tss.multiply(0.25).add(turb.multiply(0.30)).add(dop.multiply(0.25)).add(chl.multiply(0.20)).rename('WQI');
}

function palette(name){
  var dict = {
    TSS: ['#08306b','#08519c','#2171b5','#6baed6','#fd8d3c','#e31a1c'],
    Turbidity: ['#081d58','#253494','#2c7fb8','#e0ecf4'],
    DO_Proxy: ['#b10026','#fc4e2a','#fd8d3c','#78c679','#006837'],
    Chlorophyll: ['#2166ac','#1a9850','#fee08b','#f46d43','#a50026'],
    WQI: ['#00441b','#238b45','#fed976','#f16913','#99000d'],
    Mask: ['#d9d9d9','#3182bd']
  };
  return dict[name];
}

