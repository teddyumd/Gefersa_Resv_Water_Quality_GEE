  'Wet Season (Jun-Sep)': ['2023-06-01','2023-09-30']
};

// If slider is used, it overrides the preset.
function getDateRange(){
  var range = dateSlider.getValue(); // {start: Date, end: Date}
  // If user touched the slider, prefer it
  if (range && range.start && range.end){
    // Format YYYY-MM-DD without any server call
    var s = new Date(range.start);
    var e = new Date(range.end);
    var sStr = s.toISOString().slice(0,10);
    var eStr = e.toISOString().slice(0,10);
    return [sStr, eStr];
  }
  // Fallback to preset
  return PERIODS[periodSelector.getValue()];
}

