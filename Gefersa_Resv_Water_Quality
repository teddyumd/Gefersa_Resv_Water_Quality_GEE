// SEASONAL COMPARISON CHART
// =============================================

function createSeasonalChart() {
  var drySeason = sentinel2.filterDate('2024-01-01', '2024-04-30');
  var wetSeason = sentinel2.filterDate('2023-06-01', '2023-09-30');
  
  var seasons = [
    {name: 'Dry Season 2024', collection: drySeason},
    {name: 'Wet Season 2023', collection: wetSeason}
  ];
  
  var features = seasons.map(function(season) {
    if (season.collection.size().getInfo() > 0) {
      var composite = season.collection.median().clip(gefersaReservoir);
      var waterMask = createReservoirWaterMask(composite);
      var waterImage = composite.updateMask(waterMask);
      
      var tss = calculateTSS(waterImage);
      var turbidity = calculateTurbidity(waterImage);
      var doProxy = calculateDOProxy(waterImage);
      var chlorophyll = calculateChlorophyll(waterImage);
      var wqi = calculateReservoirWQI(tss, turbidity, doProxy, chlorophyll);
      
      var means = ee.Image.cat([tss, turbidity, doProxy, chlorophyll, wqi])
        .reduceRegion({
          reducer: ee.Reducer.mean(),
          geometry: gefersaReservoir,
          scale: 10,
          maxPixels: 1e9
        });
      
      return ee.Feature(null, {
        'Season': season.name,
        'TSS': means.get('TSS'),
        'Turbidity': means.get('Turbidity'),
        'DO_Proxy': means.get('DO_Proxy'),
        'Chlorophyll': means.get('Chlorophyll'),
        'WQI': means.get('WQI')
      });
    }
    return null;
  }).filter(function(feature) { return feature != null; });
  
  if (features.length > 0) {
    var chart = ui.Chart.feature.byFeature(ee.FeatureCollection(features), 'Season', 
      ['TSS', 'Turbidity', 'DO_Proxy', 'Chlorophyll', 'WQI'])
      .setChartType('ColumnChart')
      .setOptions({
        title: 'Seasonal Comparison - Dry vs Wet Season',
        hAxis: {title: 'Season'},
        vAxis: {title: 'Parameter Value (Normalized 0-1)'},
        isStacked: false,
        series: {
          0: {color: 'orange'},  // TSS
          1: {color: 'blue'},    // Turbidity
          2: {color: 'green'},   // DO Proxy
          3: {color: 'red'},     // Chlorophyll
          4: {color: 'purple'}   // WQI
        }
      });
    
    print('🌦️ SEASONAL COMPARISON CHART:');
    print(chart);
  }
}

