function getDateRangeLabel(){
  var dr = getDateRange(); // returns ['YYYY-MM-DD','YYYY-MM-DD']
  return dr[0] + ' to ' + dr[1];
}

function setChartDescription(kind){
  var rangeTxt = getDateRangeLabel();
  var text = '';

  if (kind === 'time'){
    text = 'Shows the Water Quality Index (WQI) for each valid Sentinel-2 acquisition from ' +
           rangeTxt + '. Lower values indicate better water quality. Use this to spot trends, spikes after rains, or gradual changes.';
  }
  else if (kind === 'compare'){
    text = 'Compares the mean of key indicators (TSS, Turbidity, DO Proxy, Chlorophyll, WQI) within the reservoir for ' +
           rangeTxt + '. Values are normalized (0–1) and masked to water only. Use this to see which parameter is driving WQI.';
  }
  else if (kind === 'hists'){
    text = 'Shows how pixel values are distributed within the reservoir for ' + rangeTxt +
           '. The WQI histogram highlights overall water quality spread, while Chlorophyll-a shows algal concentration variability.';
  }
  else if (kind === 'classes'){
    text = 'Breaks WQI into five classes (Excellent → Very Poor) and shows the percentage of water pixels in each class for ' +
           rangeTxt + '. This is useful for quick condition summaries and change communication.';
  }
  else if (kind === 'season'){
    text = 'Compares mean WQI across seasonal windows to illustrate hydrological effects (e.g., dilution vs. runoff). ' +
           'Use this to contrast Dry Season (Jan–Apr) and Wet Season (Jun–Sep).';
  }

  chartDescLabel.setValue(text);
}

