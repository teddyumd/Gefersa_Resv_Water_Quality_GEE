// ---------------- STATE ----------------
var state = { collection:null, currentComposite:null, currentWaterComposite:null };

function computeForRange(){
  var dr = getDateRange();
  var start = dr[0], end = dr[1];
  state.collection = loadS2(start, end);
  var composite = state.collection.median().clip(gefersaReservoir);

  // Single-band water mask
  var wm = createWaterMask(composite); // <-- one band

  state.currentComposite = composite;
  state.waterMask = wm;                           // <-- keep single-band mask
  state.currentWaterComposite = composite.updateMask(wm); // masked multiband image
}

// Append-only gradient legend. NOTE: _title is ignored because the caller
// (updateLegendForLayer) already added a title + description above.
function buildGradientLegend(_title, colors, minLabel, maxLabel){
  // gradient bar (series of small colored boxes)
  var bar = ui.Panel({
    layout: ui.Panel.Layout.Flow('horizontal'),
    style: {margin: '2px 0 2px 0'}
  });
  var n = colors.length;
  for (var i = 0; i < n; i++){
    bar.add(ui.Label({
      style: {
        backgroundColor: colors[i],
        padding: '0px',
        margin: '0px',
        width: (200 / n) + 'px',
        height: '12px',
        border: '1px solid #eee'
      }
    }));
  }
  legendPanel.add(bar);

  // min/max row
  var row = ui.Panel({
    widgets: [
      ui.Label(minLabel, {fontSize:'10px', margin:'4px 8px 0 0'}),
      ui.Label({value:'', style:{stretch:'horizontal'}}),
      ui.Label(maxLabel, {fontSize:'10px', margin:'4px 0 0 8px'})
    ],
    layout: ui.Panel.Layout.Flow('horizontal'),
    style: {width:'100%'}
  });
  legendPanel.add(row);
}

// Append-only categorical legend. NOTE: _title is ignored for same reason.
function buildCategoricalLegend(_title, items){
  items.forEach(function(it){
    legendPanel.add(ui.Panel({
      widgets: [
        ui.Label({
          style: {
            backgroundColor: it.color,
            padding: '6px',
            margin: '0 6px 0 0',
            border: '1px solid #333',
            width: '22px'
          }
        }),
        ui.Label({value: it.label, style: {fontSize:'10px'}})
      ],
      layout: ui.Panel.Layout.Flow('horizontal')
    }));
  });
}


// --- IMPROVED LEGEND FUNCTION WITH DESCRIPTIONS ---
function updateLegendForLayer(sel) {
  legendPanel.clear();

  // Helper to add a short text block under the legend title
  function addDesc(text) {
    legendPanel.add(ui.Label({
      value: text,
      style: {
        fontSize: '10px',
        color: '#444',
        margin: '4px 0 6px 0',
        textAlign: 'left',
        whiteSpace: 'normal',     // ✅ enables wrapping
        stretch: 'horizontal',    // keeps within panel width
        maxWidth: '200px'         // optional: keeps neat width
      }
    }));
  }

  if (sel === L('📍 Reservoir Boundary')) {
    legendPanel.add(ui.Label({value:'Reservoir Boundary', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Polygon outline of the Gefersa Reservoir used as the analysis area.');
    return;
  }

  if (sel === L('🛰️ True Color Satellite')) {
    legendPanel.add(ui.Label({value:'True Color (RGB)', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Natural-color Sentinel-2 imagery (bands 4,3,2). Useful for visual context and cloud checking.');
    return;
  }

  if (sel === L('💧 Water Areas Only')) {
    legendPanel.add(ui.Label({value:'Water Areas (masked composite)', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Shows only pixels classified as water using the MNDWI–AWEI combined mask.');
    return;
  }

  if (sel === L('🎯 Water Mask')) {
    legendPanel.add(ui.Label({value:'Water Mask', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Binary mask derived from spectral indices (MNDWI & AWEI). Blue = water; gray = non-water.');
    buildCategoricalLegend('Classes', [
      {color: palette('Mask')[0], label:'Non-water / masked'},
      {color: palette('Mask')[1], label:'Water'}
    ]);
    return;
  }

  if (sel === L('💧 TSS - Total Suspended Solids')) {
    legendPanel.add(ui.Label({value:'TSS – Total Suspended Solids', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Represents the concentration of particulate matter in water. High TSS → muddy or sediment-laden water.');
    buildGradientLegend('TSS (normalized)', palette('TSS'), 'Low', 'High');
    return;
  }

  if (sel === L('🌊 Turbidity - Water Clarity')) {
    legendPanel.add(ui.Label({value:'Turbidity – Water Clarity', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Measures how clear or cloudy the water is. Higher turbidity means lower transparency (less clarity).');
    buildGradientLegend('Turbidity (normalized)', palette('Turbidity'), 'Clear', 'Turbid');
    return;
  }

  if (sel === L('💨 DO Proxy - Dissolved Oxygen')) {
    legendPanel.add(ui.Label({value:'DO Proxy – Dissolved Oxygen', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Proxy for oxygen levels based on spectral indices. Higher DO indicates healthier, better-aerated water.');
    buildGradientLegend('DO Proxy (normalized)', palette('DO_Proxy'), 'Low', 'High');
    return;
  }

  if (sel === L('🌿 Chlorophyll-a - Algal Concentration')) {
    legendPanel.add(ui.Label({value:'Chlorophyll-a – Algal Concentration', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Estimates algae concentration from red-edge and blue/green ratios. High values suggest algal blooms or eutrophication.');
    buildGradientLegend('Chlorophyll-a (normalized)', palette('Chlorophyll'), 'Low', 'High');
    return;
  }

  if (sel === L('📊 Water Quality Index - Overall')) {
    legendPanel.add(ui.Label({value:'WQI – Water Quality Index', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Composite index combining TSS, Turbidity, DO Proxy, and Chlorophyll. Lower values = better overall quality.');
    buildGradientLegend('WQI (0 = Best, 1 = Worst)', palette('WQI'), 'Best', 'Worst');
    return;
  }

  if (sel === L('🥧 WQI Classes - Categories')) {
    legendPanel.add(ui.Label({value:'WQI Classes', style:{fontWeight:'bold', fontSize:'12px'}}));
    addDesc('Categorizes the overall Water Quality Index into five classes from Excellent to Very Poor.');
    buildCategoricalLegend('Classes', [
      {color:'#00441b', label:'Excellent (0.0–0.2)'},
      {color:'#238b45', label:'Good (0.2–0.4)'},
      {color:'#fed976', label:'Fair (0.4–0.6)'},
      {color:'#f16913', label:'Poor (0.6–0.8)'},
      {color:'#99000d', label:'Very Poor (0.8–1.0)'}
    ]);
    return;
  }

  // Fallback
  legendPanel.add(ui.Label({value:'No legend available', style:{fontSize:'10px', color:'#777'}}));
}


// --------------- MAP LAYERS ---------------
function updateMapLayer(){
  Map.layers().reset();
  statusLabel.setValue(L('🔄 Loading data...'));

  computeForRange();
  var comp = state.currentComposite;
  var wcomp = state.currentWaterComposite;
  var sel = layerSelector.getValue();

  if (sel === L('📍 Reservoir Boundary')){
    Map.addLayer(gefersaReservoir, {color:'red', fillColor:'00000000'}, 'Reservoir Boundary');
  } else if (sel === L('🛰️ True Color Satellite')){
    Map.addLayer(comp, {bands:['B4','B3','B2'], min:0, max:3000}, 'True Color');
  } else if (sel === L('💧 Water Areas Only')){
    Map.addLayer(wcomp, {bands:['B3','B4','B2'], min:0, max:2500}, 'Water Areas');
  } else if (sel === L('🎯 Water Mask')){
    var wm = wcomp.mask();
    Map.addLayer(wm, {min:0,max:1, palette:palette('Mask')}, 'Water Mask');
  } else {
    var tss = calcTSS(wcomp);
    var turb = calcTurbidity(wcomp);
    var dop  = calcDOProxy(wcomp);
    var chl  = calcChl(wcomp);
    var wqi  = calcWQI(tss, turb, dop, chl);

    if (sel === L('💧 TSS - Total Suspended Solids')){
      Map.addLayer(tss, {min:0, max:1, palette:palette('TSS')}, 'TSS');
    } else if (sel === L('🌊 Turbidity - Water Clarity')){
      Map.addLayer(turb, {min:0, max:1, palette:palette('Turbidity')}, 'Turbidity');
    } else if (sel === L('💨 DO Proxy - Dissolved Oxygen')){
      Map.addLayer(dop, {min:0, max:1, palette:palette('DO_Proxy')}, 'DO Proxy');
    } else if (sel === L('🌿 Chlorophyll-a - Algal Concentration')){
      Map.addLayer(chl, {min:0, max:1, palette:palette('Chlorophyll')}, 'Chlorophyll-a');
    } else if (sel === L('📊 Water Quality Index - Overall')){
      Map.addLayer(wqi, {min:0, max:1, palette:palette('WQI')}, 'WQI');
    } else if (sel === L('🥧 WQI Classes - Categories')){
      var tss = calcTSS(state.currentWaterComposite);
      var turb = calcTurbidity(state.currentWaterComposite);
      var dop  = calcDOProxy(state.currentWaterComposite);
      var chl  = calcChl(state.currentWaterComposite);
      var wqi  = calcWQI(tss, turb, dop, chl);
    
      var classes = ee.Image(0).where(wqi.lt(0.2),1)
        .where(wqi.gte(0.2).and(wqi.lt(0.4)),2)
        .where(wqi.gte(0.4).and(wqi.lt(0.6)),3)
        .where(wqi.gte(0.6).and(wqi.lt(0.8)),4)
        .where(wqi.gte(0.8),5)
        .rename('WQI_Class')
        .updateMask(state.waterMask);
    
      Map.addLayer(classes, {min:1, max:5, palette:['#00441b','#238b45','#fed976','#f16913','#99000d']}, 'WQI Classes');
    }
  }

  updateLegendForLayer(sel);
  statusLabel.setValue(L('✅ Layer loaded: ') + sel);
}

