function clearCharts(){
  chartPanel.clear();
  chartPanel.add(ui.Label({value:L('📈 Charts'), style:{fontWeight:'bold', margin:'0 0 6px 0'}}));
}

function chartTimeSeries(){
  clearCharts();
  setChartDescription('time');
  var dr = getDateRange();
  var col = loadS2(dr[0], dr[1]);

  var feats = col.map(function(img){
    var wm = createWaterMask(img);
    var wi = img.updateMask(wm);
    var tss = calcTSS(wi), turb=calcTurbidity(wi), dop=calcDOProxy(wi), chl=calcChl(wi);
    var wqi = calcWQI(tss,turb,dop,chl);
    var mean = wqi.reduceRegion({reducer:ee.Reducer.mean(), geometry:gefersaReservoir, scale:30, maxPixels:1e9});
    return ee.Feature(null, {
      date: img.date().format('YYYY-MM-dd'),
      WQI: mean.get('WQI')
    });
  }).filter(ee.Filter.notNull(['WQI']));

  var chart = ui.Chart.feature.byFeature(feats, 'date', ['WQI'])
    .setChartType('LineChart')
    .setOptions({title:'WQI Time Series (per acquisition)', hAxis:{title:'Date', slantedText:true}, vAxis:{title:'WQI (0=best, 1=worst)'}, lineWidth:2});
  chartPanel.add(chart);
}

function chartParameterComparison(){
  clearCharts();
  setChartDescription('compare');
  var comp = state.currentWaterComposite;
  var tss = calcTSS(comp), turb=calcTurbidity(comp), dop=calcDOProxy(comp), chl=calcChl(comp), wqi=calcWQI(tss,turb,dop,chl);
  var means = ee.Image.cat([tss,turb,dop,chl,wqi]).reduceRegion({
    reducer: ee.Reducer.mean(), geometry: gefersaReservoir, scale: 10, maxPixels: 1e9
  });
  var labels = ['TSS','Turbidity','DO_Proxy','Chlorophyll','WQI'];
  var arr = ee.Array(labels.map(function(l){ return means.get(l); }));
  var chart = ui.Chart.array.values({array: arr, axis:0, xLabels: labels})
    .setChartType('ColumnChart')
    .setOptions({title:'Current Water Quality Parameters (mean, masked to water)', hAxis:{title:'Parameter'}, vAxis:{title:'Normalized (0–1)'}});
  chartPanel.add(chart);
}

function chartHistograms(){
  clearCharts();
  setChartDescription('hists');
  var comp = state.currentWaterComposite;
  var chl = calcChl(comp);
  var wqi = calcWQI(calcTSS(comp), calcTurbidity(comp), calcDOProxy(comp), chl);

  var h1 = ui.Chart.image.histogram({image:wqi, region:gefersaReservoir, scale:20, maxPixels:1e9})
    .setOptions({title:'WQI Distribution'});
  var h2 = ui.Chart.image.histogram({image:chl, region:gefersaReservoir, scale:20, maxPixels:1e9})
    .setOptions({title:'Chlorophyll-a Distribution'});

  chartPanel.add(h1);
  chartPanel.add(h2);
}

function chartQualityDistribution(){
  clearCharts();
  setChartDescription('classes');

  var comp = state.currentWaterComposite;
  var wqi = calcWQI(calcTSS(comp), calcTurbidity(comp), calcDOProxy(comp), calcChl(comp));

  var classes = ee.Image(0).where(wqi.lt(0.2),1)
    .where(wqi.gte(0.2).and(wqi.lt(0.4)),2)
    .where(wqi.gte(0.4).and(wqi.lt(0.6)),3)
    .where(wqi.gte(0.6).and(wqi.lt(0.8)),4)
    .where(wqi.gte(0.8),5)
    .rename('WQI_Class')
    .updateMask(state.waterMask);   // ✅ single-band mask

    var hist = classes.reduceRegion({
        reducer: ee.Reducer.frequencyHistogram(),
        geometry: gefersaReservoir, scale: 20, maxPixels: 1e9
      }).get('WQI_Class');
    
      // --- FIXED SECTION STARTS HERE ---
      var dict = ee.Dictionary(hist);
    
      // Always look up integer-string keys ('1','2',...); default to 0 if missing.
      var keys = ee.List.sequence(1, 5);
      var vals = keys.map(function(k){
        var keyStr = ee.Number(k).format('%.0f');           // '1','2','3','4','5'
        var exists = dict.contains(keyStr);
        var v = ee.Algorithms.If(exists, dict.get(keyStr), 0);
        return ee.Number(v);
      });
    
      var total = ee.Number(vals.reduce(ee.Reducer.sum()));
    
      // Avoid divide-by-zero: if total==0, keep zeros
      var perc = vals.map(function(v){
        return ee.Number(ee.Algorithms.If(
          total.gt(0),
          ee.Number(v).divide(total).multiply(100),
          0
        ));
      });
  var labels = ['Excellent','Good','Fair','Poor','Very Poor'];
  var chart = ui.Chart.array.values({array: ee.Array(perc), axis:0, xLabels: labels})
    .setChartType('PieChart')
    .setOptions({title:'WQI Classes (% of masked pixels)'});

  chartPanel.add(chart);
}

function chartSeasonalComparison(){
  clearCharts();
  setChartDescription('season');
  var seasons = [
    {name:'Dry Season 2024', start:'2024-01-01', end:'2024-04-30'},
    {name:'Wet Season 2023', start:'2023-06-01', end:'2023-09-30'}
  ];
  var feats = ee.FeatureCollection(seasons.map(function(s){
    var col = loadS2(s.start, s.end);
    var comp = col.median().clip(gefersaReservoir);
    var wm = createWaterMask(comp);
    var wi = comp.updateMask(wm);
    var wqi = calcWQI(calcTSS(wi), calcTurbidity(wi), calcDOProxy(wi), calcChl(wi));
    var mean = wqi.reduceRegion({reducer:ee.Reducer.mean(), geometry:gefersaReservoir, scale:30, maxPixels:1e9});
    return ee.Feature(null, {'Season': s.name, 'WQI': mean.get('WQI')});
  }));
  var chart = ui.Chart.feature.byFeature(feats, 'Season', ['WQI'])
    .setChartType('ColumnChart')
    .setOptions({title:'Seasonal Comparison – WQI', vAxis:{title:'WQI'}});
  chartPanel.add(chart);
}

function displayChart(){
  var sel = chartSelector.getValue();
  statusLabel.setValue(L('📊 Generating chart...'));
  if (sel === L('📈 Time Series Analysis')) chartTimeSeries();
  else if (sel === L('📊 Parameter Comparison')) chartParameterComparison();
  else if (sel === L('📈 Distribution Histograms')) chartHistograms();
  else if (sel === L('🥧 Quality Class Distribution')) chartQualityDistribution();
  else if (sel === L('🌦️ Seasonal Comparison')) chartSeasonalComparison();
  statusLabel.setValue(L('✅ Chart displayed: ') + sel);
}

// --------------- EXPORT ----------------
function doExport(){
  var comp = state.currentWaterComposite;
  var tss = calcTSS(comp), turb=calcTurbidity(comp), dop=calcDOProxy(comp), chl=calcChl(comp);
  var wqi = calcWQI(tss,turb,dop,chl).rename('WQI');
  var out = wqi.addBands([tss, turb, dop, chl]);
  Export.image.toDrive({
    image: out.toFloat(),
    description: 'Gefersa_Water_Quality_App_Export',
    scale: 10,
    region: gefersaReservoir,
    fileFormat: 'GeoTIFF',
    crs: 'EPSG:32637',
    maxPixels: 1e13
  });
  statusLabel.setValue(L('📤 Export task started – check Tasks tab'));
}

