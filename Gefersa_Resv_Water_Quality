    border: '2px solid #43A047'
  }
});

var infoTitle = ui.Label({
  value: 'ℹ️ GEFERSA RESERVOIR MONITORING',
  style: {
    fontWeight: 'bold', 
    fontSize: '14px', 
    margin: '0 0 10px 0', 
    color: '#43A047'
  }
});

var infoContent = ui.Label({
  value: 'HOW TO USE:\n' +
         '1. Only "Reservoir Boundary" is visible by default\n' +
         '2. Turn on layers in the Layers panel (top-left)\n' +
         '3. Refer to legend on right for color meanings\n' +
         '4. Check Console below for statistics\n\n' +
         'LAYER DESCRIPTIONS:\n' +
         '• TSS: Sediment and particles in water\n' +
         '• Turbidity: Water clarity/cloudiness\n' +
         '• DO Proxy: Oxygen levels for aquatic life\n' +
