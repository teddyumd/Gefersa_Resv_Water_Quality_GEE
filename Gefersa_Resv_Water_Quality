// =============================================
// STEP 7: STATISTICAL ANALYSIS
// =============================================

var stats = ee.Image.cat([tss, turbidity, doProxy, chlorophyll, waterQualityIndex])
  .reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: gefersaReservoir,
    scale: 10,
    maxPixels: 1e9
  });

stats.evaluate(function(result) {
  print('=== 📊 GEFERSA RESERVOIR WATER QUALITY ===');
  
  if (result.TSS_mean) {
    print('💧 TSS: ' + (result.TSS_mean * 8).toFixed(2) + ' mg/L proxy');
    print('🌊 Turbidity: ' + (result.Turbidity_mean * 12).toFixed(2) + ' NTU proxy');
    print('💨 DO Proxy: ' + (result.DO_Proxy_mean * 12).toFixed(2) + ' mg/L proxy');
    print('🌿 Chlorophyll: ' + (result.Chlorophyll_mean * 60).toFixed(2) + ' μg/L proxy');
    print('🎯 WQI: ' + result.WQI_mean.toFixed(3));
    
    var quality = result.WQI_mean < 0.2 ? 'EXCELLENT' :
                  result.WQI_mean < 0.4 ? 'GOOD' :
                  result.WQI_mean < 0.6 ? 'FAIR' :
                  result.WQI_mean < 0.8 ? 'POOR' : 'VERY POOR';
    print('Overall Quality: ' + quality);
  }
});

