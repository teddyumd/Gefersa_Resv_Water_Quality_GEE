// =============================================
// QUALITY CLASS DISTRIBUTION PIE CHART
// =============================================

function createQualityPieChart() {
  var classAreas = wqiClasses.reduceRegion({
    reducer: ee.Reducer.frequencyHistogram(),
    geometry: gefersaReservoir,
    scale: 10,
    maxPixels: 1e9
  });

  classAreas.evaluate(function(result) {
    if (result.risk_class) {
      var classData = Object.keys(result.risk_class).map(function(classId) {
        var area = result.risk_class[classId] * 100; // Convert to hectares
        var className = getQualityClassName(parseInt(classId));
        var color = getQualityClassColor(parseInt(classId));
        return {class: className, area: area, color: color};
      });
      
      var chartData = ee.FeatureCollection(classData.map(function(item, i) {
        return ee.Feature(null, {
          'Quality Class': item.class,
          'Area (ha)': item.area,
          'style': {color: item.color}
        });
      }));
      
      var pieChart = ui.Chart.feature.byProperty(chartData, 'Quality Class', 'Area (ha)')
        .setChartType('PieChart')
        .setOptions({
          title: 'Water Quality Classes - Area Distribution',
          slices: classData.reduce(function(slices, item, i) {
            slices[i] = {color: item.color};
            return slices;
          }, {}),
          pieSliceText: 'value',
          sliceVisibilityThreshold: 0
        });
      
      print('🥧 QUALITY CLASS DISTRIBUTION PIE CHART:');
      print(pieChart);
    }
  });
}

function getQualityClassName(classId) {
  var names = {
    1: 'Excellent',
    2: 'Good', 
    3: 'Fair',
    4: 'Poor',
    5: 'Very Poor'
  };
  return names[classId] || 'Unknown';
}

function getQualityClassColor(classId) {
  var colors = {
    1: 'darkgreen',
    2: 'green',
    3: 'yellow', 
    4: 'orange',
    5: 'red'
  };
  return colors[classId] || 'gray';
}

