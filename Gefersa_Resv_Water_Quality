    style: {fontSize: '9px', margin: '0 0 5px 0'}
  });
  
  var row = ui.Panel({
    widgets: [colorBox, descLabel],
    layout: ui.Panel.Layout.Flow('horizontal')
  });
  
  legendPanel.add(row);
});

Map.add(legendPanel);

