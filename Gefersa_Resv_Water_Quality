// TIME SERIES CHART - Quarterly Analysis (FIXED)
// =============================================

function createTimeSeriesChart() {
  var quarters = ee.List([
    {name: 'Q1-2023', start: '2023-01-01', end: '2023-03-31'},
    {name: 'Q2-2023', start: '2023-04-01', end: '2023-06-30'},
    {name: 'Q3-2023', start: '2023-07-01', end: '2023-09-30'},
    {name: 'Q4-2023', start: '2023-10-01', end: '2023-12-31'},
    {name: 'Q1-2024', start: '2024-01-01', end: '2024-03-31'},
    {name: 'Q2-2024', start: '2024-04-01', end: '2024-06-30'}
  ]);
  
  var features = ee.FeatureCollection(quarters.map(function(quarter) {
    quarter = ee.Dictionary(quarter);
    var quarterlyData = sentinel2.filterDate(quarter.get('start'), quarter.get('end'));
    
    // Check if we have images for this quarter
    var composite = ee.Algorithms.If(
      quarterlyData.size().gt(0),
      quarterlyData.median().clip(gefersaReservoir),
      null
    );
    
    return ee.Feature(null, ee.Algorithms.If(
      composite,
      (function() {
        var waterMask = createReservoirWaterMask(ee.Image(composite));
        var waterImage = ee.Image(composite).updateMask(waterMask);
        
        var tss = calculateTSS(waterImage);
        var turbidity = calculateTurbidity(waterImage);
        var doProxy = calculateDOProxy(waterImage);
        var chlorophyll = calculateChlorophyll(waterImage);
        var wqi = calculateReservoirWQI(tss, turbidity, doProxy, chlorophyll);
        
        var means = ee.Image.cat([tss, turbidity, doProxy, chlorophyll, wqi])
          .reduceRegion({
            reducer: ee.Reducer.mean(),
            geometry: gefersaReservoir,
            scale: 10,
            maxPixels: 1e9
          });
        
        return ee.Dictionary({
          'Period': quarter.get('name'),
          'TSS': means.get('TSS'),
          'Turbidity': means.get('Turbidity'),
          'DO_Proxy': means.get('DO_Proxy'),
          'Chlorophyll': means.get('Chlorophyll'),
          'WQI': means.get('WQI')
        });
      })(),
      null
    ));
  })).filter(ee.Filter.notNull(['Period']));
  
  // Create chart
  var chart = ui.Chart.feature.byFeature({
    features: features, 
    xProperty: 'Period', 
    yProperties: ['TSS', 'Turbidity', 'DO_Proxy', 'Chlorophyll', 'WQI']
  })
  .setChartType('LineChart')
  .setOptions({
    title: 'Gefersa Reservoir - Quarterly Water Quality Trends (2023-2024)',
    hAxis: {title: 'Time Period'},
    vAxis: {title: 'Parameter Value (Normalized 0-1)'},
    lineWidth: 3,
    series: {
      0: {color: 'orange', lineWidth: 4},
      1: {color: 'blue', lineWidth: 3},
      2: {color: 'green', lineWidth: 3},
      3: {color: 'red', lineWidth: 3},
      4: {color: 'purple', lineWidth: 5}
    }
  });
  
  print('📈 QUARTERLY TIME SERIES CHART:');
  print(chart);
}

